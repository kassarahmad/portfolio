{
  "name": "ahmad-kassar-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio site of Ahmad Kassar. Static, no runtime dependencies.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:e2e": "node --test \"e2e/**/*.test.mjs\"",
    "og": "node scripts/og.mjs",
    "cv:pdf": "node scripts/cv-pdf.mjs",
    "format:check": "npx --yes prettier@3.8.1 --check ."
  }
}
