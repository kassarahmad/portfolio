# Copy to .env. Generate values with: node src/cli.js new-secret | new-token | hash-password
PORT=4000
HOSTWATCH_DB=./data/hostwatch.db
HOSTWATCH_RETENTION_HOURS=48

# Signs dashboard session cookies. Changing it signs everyone out.
HOSTWATCH_SESSION_SECRET=replace-with-node-src-cli-new-secret
# HOSTWATCH_PASSWORD='your passphrase' node src/cli.js hash-password
HOSTWATCH_PASSWORD_HASH=scrypt$replace$me
# One token per host; a token can only report for its own host name.
HOSTWATCH_AGENT_TOKENS=web-1=replace-with-new-token,db-1=replace-with-another-token

# Optional
HOSTWATCH_RULES_FILE=
HOSTWATCH_ALERT_WEBHOOK=
COOKIE_SECURE=false
TRUST_PROXY=false
LOG_LEVEL=info
