# =====================================================================
#  AI Locale - configurazione. Copia questo file in ".env" e modificalo.
#  Il file .env contiene segreti: non condividerlo e non metterlo su Git.
# =====================================================================

# --- Server web -------------------------------------------------------
# 127.0.0.1 = raggiungibile SOLO da questo PC (consigliato).
AILOCALE_HOST=127.0.0.1
AILOCALE_PORT=8765

# --- Motore LLM (API compatibile OpenAI) --------------------------------
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local
EMBED_BASE_URL=http://127.0.0.1:8081/v1
EMBED_MODEL=local-embed
# Visione: vuoto = usa il modello chat (multimodale). Oppure un server separato.
VISION_BASE_URL=
VISION_MODEL=
# Modalita' locale rigorosa: rifiuta server LLM non locali (cloud). Lascia true.
STRICT_LOCAL=true

# --- Gestione automatica di llama-server (impostata da setup.ps1) ---------
# Percorso di llama-server.exe. Se vuoto, avvia llama-server tu a mano.
LLAMA_SERVER_PATH=
# File .gguf dentro la cartella "models"
CHAT_MODEL_FILE=
# Proiettore multimodale (mmproj) del modello chat: abilita la VISIONE (immagini, OCR)
CHAT_MMPROJ_FILE=
EMBED_MODEL_FILE=
LLAMA_AUTOSTART=true
# Contesto TOTALE: viene diviso tra gli slot paralleli (16384 / 2 = 8192 per agente)
LLAMA_CTX_SIZE=16384
LLAMA_PARALLEL=2
# 99 = tutti i layer sulla GPU. Riduci se la VRAM non basta.
LLAMA_GPU_LAYERS=99
# Argomenti extra per llama-server (opzionale)
LLAMA_EXTRA_ARGS=

# --- Sicurezza -------------------------------------------------------------
# Lascia vuoto per disattivare l'accesso remoto (consigliato finché non usi Tailscale).
# Per abilitarlo: genera un token lungo e casuale e imposta AILOCALE_HOST sull'IP Tailscale.
AILOCALE_API_TOKEN=
# Host consentiti nell'header Host (aggiungi l'IP/nome Tailscale se accedi da remoto)
AILOCALE_ALLOWED_HOSTS=127.0.0.1,localhost
# Segreto per firmare le sessioni remote (se vuoto: casuale a ogni avvio)
AILOCALE_SESSION_SECRET=
AILOCALE_MAX_UPLOAD_MB=25
# Secondi di attesa per l'approvazione di un'azione prima di considerarla rifiutata
AILOCALE_APPROVAL_TIMEOUT=300
AILOCALE_COMMAND_TIMEOUT=60

# --- Strumenti -----------------------------------------------------------------
# Cartelle extra dove gli agenti possono leggere/creare file e progetti (separate da ;)
# Esempio: AILOCALE_ALLOWED_PATHS=C:\Users\Ahmad\Progetti;D:\Documenti\Universita
AILOCALE_ALLOWED_PATHS=
# Motore di ricerca: vuoto = DuckDuckGo. Oppure un'istanza SearXNG self-hosted (es. http://127.0.0.1:8888)
SEARXNG_URL=
# false = vedi la finestra del browser mentre l'agente naviga
BROWSER_HEADLESS=true
WEB_TIMEOUT=20
