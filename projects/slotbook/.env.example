# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=slotbook
PGPASSWORD=change-me
PGDATABASE=slotbook
PGSSL=false

# At least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-value

# Set to false only for plain-http local development
COOKIE_SECURE=false
# true when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
CORS_ORIGINS=

BUSINESS_TZ=Europe/Rome
SLOT_STEP_MIN=15
MIN_LEAD_MIN=60
BOOKING_HORIZON_DAYS=60
CANCEL_CUTOFF_MIN=120
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_SESSION_PER_MIN=60
RATE_LIMIT_API_PER_MIN=300
LOG_LEVEL=info
