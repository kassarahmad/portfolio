# Copy to /opt/shipyard/.env on the server. Not secret: secrets live in ./secrets.
DOMAIN=book.example.com
MONITOR_DOMAIN=monitor.example.com
ACME_EMAIL=you@example.com

# Container registry, e.g. ghcr.io/<github-user>
REGISTRY=ghcr.io/your-user
# Immutable image tags (git SHAs). deploy.sh updates these.
SLOTBOOK_TAG=replace-with-sha
HOSTWATCH_TAG=replace-with-sha

BUSINESS_TZ=Europe/Rome
